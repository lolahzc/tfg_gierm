<?xml version='1.0'?>
<!-- Ported from Gazebo Classic to Gazebo Sim:
       - sdf 1.0 -> 1.8
       - dropped the Classic-only DynamicModelPlugin
       - the original inertias had negative ixx/izz, which are invalid
       - box collision instead of the full body mesh: it is static scenery -->
<sdf version="1.8">
  <model name="jeff_electrician">
    <static>true</static>
    <link name="link">
      <inertial>
        <mass>80.0</mass>
        <inertia>
          <ixx>27.7</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>27.7</iyy>
          <iyz>0.0</iyz>
          <izz>1.6</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.9 0 0 0</pose>
        <geometry>
          <box>
            <size>0.6 0.4 1.8</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://jeff_electrician/jeff_electrician.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>

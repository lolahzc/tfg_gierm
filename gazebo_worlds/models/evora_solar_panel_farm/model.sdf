<?xml version="1.0" ?>
<!-- Ported from Gazebo Classic to Gazebo Sim: the original used an Ogre
     material script, which Gazebo Sim does not support, so the same texture
     is applied as a PBR albedo map. -->
<sdf version="1.8">
  <model name="evora_solar_panel_farm">
    <static>true</static>
    <link name="floor">
      <collision name="collision">
        <geometry>
          <box>
            <size>186.84 293.66 0.1</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <box>
            <size>186.84 293.66 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://evora_solar_panel_farm/materials/textures/evora_solar_panel_farm.jpg</albedo_map>
              <metalness>0.0</metalness>
              <roughness>0.9</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>

<?xml version="1.0"?>
<!-- Evora solar farm world for Gazebo Sim, built with the same structure as
     as2_gazebo_assets/worlds/heliostatos.sdf.jinja so it renders identically.

     Selected with `world_name: "evora"` in the mission_planner_gazebo world
     yaml. as2_gazebo_assets finds it because simulation_launch.py puts
     share/mission_planner/worlds and share/mission_planner/models on
     GZ_SIM_RESOURCE_PATH.

     The three jeff_electrician models sit on the human_target positions from
     mission_planner/config/conf.yaml, so Monitor tasks have something visible
     underneath. -->
<sdf version="1.8"> <world name="evora">
        <physics name="4ms" type="ignored">
            <max_step_size>0.004</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>

        <plugin filename="gz-sim-physics-system"
                name="gz::sim::systems::Physics"></plugin>
        <plugin filename="gz-sim-scene-broadcaster-system"
                name="gz::sim::systems::SceneBroadcaster"></plugin>
        <plugin filename="gz-sim-user-commands-system"
                name="gz::sim::systems::UserCommands"></plugin>
        <plugin filename="gz-sim-sensors-system"
                name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
        <plugin filename="gz-sim-contact-system"
                name="gz::sim::systems::Contact"></plugin>

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        {% if use_origin -%}
        <spherical_coordinates>
            <surface_model>EARTH_WGS84</surface_model>
            <world_frame_orientation>ENU</world_frame_orientation>
            <latitude_deg>{{ origin.latitude }}</latitude_deg>
            <longitude_deg>{{ origin.longitude }}</longitude_deg>
            <elevation>{{ origin.altitude }}</elevation>
            <heading_deg>0.0</heading_deg>
        </spherical_coordinates>
        {% endif -%}

        <include>
            <uri>model://ground_plane</uri>
        </include>

        <!-- Sits just above ground_plane to avoid z-fighting. The box is
             0.1 tall, so at z=-0.04 its top face lands at +0.01. -->
        <include>
            <uri>model://evora_solar_panel_farm</uri>
            <name>granja_solar_evora</name>
            <pose>0 0 -0.04 0 0 0</pose>
        </include>

        <!-- Signs and ground markings, generated by
             scripts/gen_mission_labels.py from mission.yaml and conf.yaml. -->
        <include>
            <uri>model://mission_labels</uri>
            <name>carteles_mision</name>
            <pose>0 0 0 0 0 0</pose>
        </include>

        <include>
            <uri>model://jeff_electrician</uri>
            <name>operario_1</name>
            <pose>10.0 10.0 0.02 0 0 -1.57</pose>
        </include>
        <include>
            <uri>model://jeff_electrician</uri>
            <name>operario_2</name>
            <pose>-5.0 15.0 0.02 0 0 0.0</pose>
        </include>
        <include>
            <uri>model://jeff_electrician</uri>
            <name>operario_3</name>
            <pose>5.0 20.0 0.02 0 0 1.57</pose>
        </include>

    </world>
</sdf>
